# Local development secrets. Copy to .env and fill in — never commit .env.
OPENAI_API_KEY=sk-...
JWT_SIGNING_SECRET=change-me-to-a-long-random-string

# Local dev only — in deployed environments these come from SSM Parameter Store.
AWS_REGION=us-east-1
UPLOADS_BUCKET_NAME=teagent-uploads-dev
PROFILES_TABLE_NAME=TeagentProfiles-dev

# Uncomment both to run fully offline against Docker (see docker-compose.yml) — no AWS account
# needed at all. Run `npm run local:up`, then `npm run dynamodb:setup -w @teagent/backend` and
# `npm run s3:setup -w @teagent/backend` once to create the table/bucket.
# DYNAMODB_ENDPOINT=http://localhost:8000
# S3_ENDPOINT=http://localhost:9100

# Frontend (Vite) — local dev API base URL
VITE_API_BASE_URL=http://localhost:3000
